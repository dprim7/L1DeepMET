+# ─── L1DeepMET extended recipe ─────────────────────────────────────────────
+# Activate everything plausibly useful for MET training. Each block is opt-in
+# via the L1DEEPMET_EXTENDED env var (default on) so this same config still
+# runs vanilla when invoked with L1DEEPMET_EXTENDED=0.
+# 14_2_X does have addCTL2Met available — uncomment to also produce L1Layer2 MET.
+import os as _l1dmet_os
+if _l1dmet_os.environ.get("L1DEEPMET_EXTENDED", "1") == "1":
+    saveCands()                   # per-candidate state (extended moreVariables above)
+    saveGenCands()                # gen-level particles for METAllVisible
+    # L1 primary vertices — exposes PV z0 + sum-pt + multiplicity so the
+    # model can compute its own z0_rel per candidate (PUPPI's principal
+    # PU-rejection discriminant). Uses the standard L1T vertex emulator
+    # already in the process path (extraPFStuff).
+    process.l1deepmetVtxTable = cms.EDProducer("VertexWordFlatTableProducer",
+        src = cms.InputTag("l1tVertexFinderEmulator", "l1verticesEmulation"),
+        name = cms.string("L1Vtx"),
+        cut = cms.string(""),
+        doc = cms.string("L1 primary vertices from emulator (L1DeepMET extended)"),
+        singleton = cms.bool(False),
+        extension = cms.bool(False),
+        variables = cms.PSet(
+            z0    = Var("z0",  float, precision=16, doc="vertex z0 [cm]"),
+            sumPt = Var("pt",  float, precision=10, doc="vertex sum pt [GeV]"),
+        ),
+    )
+    process.p += process.l1deepmetVtxTable
+
+# Universal CLI overrides for the producer (always active). Lets
+# scripts/ntuple_produce.py invoke us as
+#   cmsRun runPerformanceNTuple.py \
+#       inputFiles=file:/tmp/inputs140X_NNNN.root \
+#       maxEvents=1000 \
+#       outputFile=/ceph/.../perfNano_NNNN.root
+# Without these overrides cmsRun silently uses the hardcoded placeholder
+# `inputs125X.root` at the top of this file and ignores the CLI args.
+# We parse sys.argv directly instead of using VarParsing("analysis") to
+# avoid the latter's _numEventN suffix on outputFile.
+import sys as _l1dmet_sys
+_l1dmet_overrides = {}
+for _arg in _l1dmet_sys.argv[1:]:
+    if "=" in _arg:
+        _k, _v = _arg.split("=", 1)
+        _l1dmet_overrides[_k] = _v
+if "inputFiles" in _l1dmet_overrides:
+    process.source.fileNames = cms.untracked.vstring(
+        _l1dmet_overrides["inputFiles"].split(",")
+    )
+if "maxEvents" in _l1dmet_overrides:
+    process.maxEvents.input = cms.untracked.int32(int(_l1dmet_overrides["maxEvents"]))
+if "outputFile" in _l1dmet_overrides:
+    # process.outnano carries the FlatTable Events tree (the actual ntuple);
+    # TFileService is auxiliary (ResponseNTuplizer scratch). Both follow
+    # --outputFile so each cmsRun job's outputs cluster together.
+    process.outnano.fileName = cms.untracked.string(_l1dmet_overrides["outputFile"])
+    _stem, _ext = _l1dmet_os.path.splitext(_l1dmet_overrides["outputFile"])
+    process.TFileService.fileName = cms.string(f"{_stem}_perfTuple{_ext}")
+# ───────────────────────────────────────────────────────────────────────────
